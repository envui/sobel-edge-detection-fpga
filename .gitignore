# ---- Vivado generated project trees ----------------------------------------
# Everything below is regenerated by scripts/create_project.tcl. Only sources,
# constraints, IP configuration (.xci), and memory files belong in git.
build/
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
*.data/
.Xil/
*.jou
*.log
*.str
*.wdb
*.pb
*.rpt
*.dcp
*.bit
*.bin
*.ltx
*.xsa
*.hdf
hs_err_pid*.log

# Vivado project file is intentionally NOT tracked -- create_project.tcl is the
# source of truth. Remove the next line if you prefer to commit the .xpr.
*.xpr

# ---- IP output products -----------------------------------------------------
# Keep the .xci configuration; discard everything Vivado synthesizes from it.
ip/*/
!ip/*.xci

# ---- Simulation -------------------------------------------------------------
sim/*.vvp
sim/*.vcd
sim/*.fst
sim/*.lxt
sim/image.mem
sim/image_small.mem
xsim.dir/
webtalk*.jou
webtalk*.log

# ---- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
.DS_Store
desktop.ini
